{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-remote:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list)",
      "Bash(vercel whoami:*)",
      "Bash(vercel ls:*)",
      "Bash(vercel inspect:*)",
      "Bash(vercel project ls:*)",
      "Bash(vercel env ls:*)",
      "Bash(eas whoami:*)",
      "Bash(eas build:list:*)",
      "Bash(eas build:view:*)",
      "Bash(curl -s https://ngo-eight-umber.vercel.app/api/v1/health:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel remove:*)",
      "Bash(vercel env add:*)",
      "Bash(vercel env rm:*)",
      "Bash(vercel env pull:*)",
      "Bash(eas build --:*)",
      "Bash(eas build -p:*)",
      "Bash(eas init:*)",
      "Bash(eas credentials:*)",
      "Bash(eas submit:*)",
      "Bash(npm run migrate:up:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./.vercel/.env*)"
    ]
  }
}
