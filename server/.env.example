PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_SSL=true
# Optional inline PEM certificate/chain (escaped \n is accepted); DATABASE_SSL_CA_PATH takes precedence when both are set.
DATABASE_SSL_CA=
DATABASE_SSL_CA_PATH=C:/path/to/development-db-ca.crt
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Allowlist this exact public web URL in Supabase Auth Redirect URLs.
VOLUNTEER_INVITE_REDIRECT_URL=http://localhost:5173/accept-invite
# Keep disabled until migration 011 and the public-registration abuse controls are verified.
PUBLIC_VOLUNTEER_REGISTRATION_ENABLED=false
LOCATION_RETENTION_DAYS=30
CORS_ORIGIN=http://localhost:5173
# Final-pilot rollout: keep OFF until the reviewed proposed migration and staging tests pass.
VOLUNTEER_IDENTITY_REQUIRED=false
DRIVER_TRACKING_REQUIRED=false
FOOD_REQUEST_IDEMPOTENCY_ENABLED=false
TRACKING_GEOCODING_ENABLED=false
TRACKING_GEOCODER_CONTACT=
IDENTITY_DELETION_APPROVED=false
NOTIFICATION_OUTBOX_ENABLED=false
WHATSAPP_SENDING_ENABLED=false
PUBLIC_APP_ORIGIN=https://web.example.org
NOTIFICATION_DISPATCH_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ADMIN_OPTED_IN=false
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_DONATION_RECEIVED=
WHATSAPP_TEMPLATE_VOLUNTEER_ASSIGNMENT=
WHATSAPP_TEMPLATE_DRIVER_ASSIGNMENT=
WHATSAPP_TEMPLATE_VOLUNTEER_APPLICATION=
ANDROID_RELEASE_APPROVED=false
ANDROID_RELEASE_URL=
ANDROID_RELEASE_VERSION=
ANDROID_RELEASE_BUILD_ID=
ANDROID_RELEASE_SHA256=
ANDROID_SIGNING_CERT_SHA256=
