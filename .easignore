# Keep these rules aligned with .gitignore. EAS uses this file instead of .gitignore.
# Dependencies and generated output
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.expo/
**/.expo/
.eas/
*.tsbuildinfo
.npm-cache/

# Local environment and credentials (keep examples)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.crt
*.pem
**/google-services.json

# Local tools and logs
.vscode/
**/.vscode/
.idea/
**/.idea/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

/WEB/
.vercel/

# Documentation and local Git metadata are unnecessary in an Android build.
/docs/
.git
